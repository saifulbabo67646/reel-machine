  "lines": [
    {"speaker": "barista", "text": "어서 오세요!", "reading": "Eoseo oseyo!", "meaning": "Welcome!",
     "emotion": "happy"},
    {"speaker": "guest", "text": "아이스 아메리카노 하나 주세요.", "reading": "Aiseu amerikano hana juseyo.",
