        {"kind": "hero", "state": "pulse", "at": {"line": 0, "word": "AI"}},
        {"kind": "hero", "state": "screen", "text": "OFFLINE ✓", "at": {"line": 1}},
        {"kind": "emoji", "emoji": "📵", "at": {"line": 1, "word": "ネットなし"}}
